<?xml version="1.0" encoding="utf-8"?>
<!--
  堆叠卡片的外露「底层卡片」边缘：仅上侧圆角。
  颜色与正面卡片（bg_stack_front）同源，配合视图 alpha 淡化，
  明暗主题下都能呈现「越靠后越淡」的层叠关系（与应用图标一致）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <corners
        android:topLeftRadius="@dimen/radius_md"
        android:topRightRadius="@dimen/radius_md" />
</shape>
